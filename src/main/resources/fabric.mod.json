{
  "schemaVersion": 1,
  "id": "ahr2",
  "version": "${version}",
  "name": "A Hundov Ranch 2.0",
  "description": "Minecraft Mod on Fabric, a hardcore survival overhaul centered around food.",
  "authors": ["hundov"],
  "contact": {},
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "main.client.mainDataGenerator"
    ],
    "client": [
      "main.client.mainClient"
    ],
    "main": [
      "main.AHRMain"
    ]
  },
  "mixins": [
    "ahr2.mixins.json",
    {
      "config": "ahr2.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
